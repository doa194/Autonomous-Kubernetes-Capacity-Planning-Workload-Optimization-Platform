{
  "uid": "capacity-overview",
  "title": "Capacity platform overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "capacity-lab"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Workload CPU: usage vs request (millicores)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{namespace=~\"workloads-.*\",container!=\"\"}[5m])) * 1000",
          "legendFormat": "{{pod}} usage"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=~\"workloads-.*\",resource=\"cpu\"}) * 1000",
          "legendFormat": "{{pod}} request"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Workload memory: working set vs request",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=~\"workloads-.*\",container!=\"\"})",
          "legendFormat": "{{pod}} working set"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=~\"workloads-.*\",resource=\"memory\"})",
          "legendFormat": "{{pod}} request"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU throttling ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"workloads-.*\"}[5m])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=~\"workloads-.*\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Demo workload p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, workload) (rate(lab_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{workload}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Platform request rate by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, status_class) (rate(capacity_http_requests_total[5m]))",
          "legendFormat": "{{service}} {{status_class}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Platform p95 latency by service",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(capacity_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
